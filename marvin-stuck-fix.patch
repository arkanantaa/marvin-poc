+    await session.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] });
+    await expect(page.locator("html")).toHaveAttribute("data-locked", "true");
+    await expect(page.locator("html")).toHaveAttribute("data-portal", "off");
