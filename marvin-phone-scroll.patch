+:root:not([data-locked="true"]) body { touch-action: none; }
 :root[data-locked="true"] .work-scene { position: fixed; inset: 0; margin: 0; overflow-y: auto; overscroll-behavior: contain; }
 :root[data-portal="on"] .stage { z-index: 2; background: transparent; }
 :root[data-portal="on"] .work-scene { z-index: 1; background: transparent; will-change: transform; }
